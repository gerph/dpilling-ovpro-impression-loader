static xfnlink fnlink;



static xfnlink * firstlink;

static int fncmp(const void * p1,const void * p2)
{
 return(strcmp(((fndefn *)p1)->name,((fndefn *)p2)->name));
}


os_error * addsymboltable(fndefn * fns,xfnlink * fnlink)
{
 int i;
 xfnlink * link;

 fnlink->next=NULL;
 fnlink->fns=fns;
 i=0;
 while(fns[i].name) i++;
 fnlink->n=i;

 qsort(fns,i,sizeof(fndefn),fncmp);

 if(firstlink)
 {
  link=firstlink;
  while(link->next) link=link->next;
  link->next=fnlink;
 }
 else firstlink=fnlink;

 fnlink->next=NULL;

 return(NULL);
}


/*****************************************************************************/
/* x symbol table manager */

char           * xsymheap;  /* heap used to store symbol table        */
static int       xheapsize; /* pointer to first free location in heap */
static symstk  * xsyms;     /* list of pointers to first entry in each stage */
int              xnsyms;    /* number of stages */



static int xsearchfn(void * key1,void * key2)
{

 return(strcmp(
               ((symstr*)(((char*)key1)-sizeof(avlstr)+sizeof(int)))->key,
               ((symstr*)(((char*)key2)-sizeof(avlstr)+sizeof(int)))->key
       ));
}


/* given a name, add it to table, return offset */

int xadd(char ** name,int val,int type,int mode)
{
 symstr * p;
 int      len;
 int      node;

 len=strlen(*name)+sizeof(symstr);
 len=(len+3)&(~3);

 flex_chunk((flex_ptr)&xsymheap,xheapsize+len,XHEAPCHUNK);
 node=xheapsize;
 p=xptr(xheapsize);
 xheapsize+=len;

 strcpy(p->key,*name);
 p->type=type;
 p->val=val;
 p->mode=mode;
 p->args=0;
 p->argc=0;

 avlsearch(node,&xsyms[xnsyms-1].root,xsymheap,xsearchfn);

 return(node);
}




static int xfindfn(void * key1,void * key2)
{
 return(strcmp((char*)key1,
               ((symstr*)(((char*)key2)-sizeof(avlstr)+sizeof(int)))->key));
}



/* given a name, return symbol table offset, or -1 if it does not exist */

int xfindi(char * name,int * internal)
{
 int       stage;
 int       hit;
 int       lo;
 int       hi;
 int       probe;
 int       code;
 xfnlink * fnlink;

 *internal=0;

 for(stage=xnsyms-1;stage>=0;stage--)
 {
  if((hit=avlfind(name,xsyms[stage].root,xsymheap,xfindfn))!=-1) return(hit);
 }

 fnlink=firstlink;
 while(fnlink)
 {
  lo=0;
  hi=(fnlink->n)-1;

  while(1)
  {
   probe=(lo+hi)/2;

   code=strcmp(fnlink->fns[probe].name,name);
   if(!code)
   {
    *internal=1;
    return((int)&fnlink->fns[probe]);
   }
   if(code>0) hi=probe-1;
   else       lo=probe+1;
   if(lo>hi) break;
  }
  fnlink=fnlink->next;
 }

 return(XSNOTFOUND);
}



int xfind(char * name)
{
 int internal;
 return(xfindi(name,&internal));
}



/* given a name, return symbol table offset, or -1 if it does not exist */
/* only one stage */

int xfinds(char * name,int stage)
{
 int hit;

 hit=avlfind(name,xsyms[stage-1].root,xsymheap,xfindfn);

 return(hit==-1?XSNOTFOUND:hit);
}




/*removes 'stage', and any newer stages too */

void xremstage(int stage)
{
 xnsyms=stage-1;
 xheapsize=xsyms[xnsyms].heap;
 flex_chunk((flex_ptr)&xsyms,xnsyms*sizeof(symstk),XSYMCHUNK);
 flex_chunk((flex_ptr)&xsymheap,xheapsize,XHEAPCHUNK);
}




/* adds another stage to the symbol table */
/* notice first stage is number 1 */

int xaddstage(void)
{
 xnsyms++;
 flex_chunk((flex_ptr)&xsyms,xnsyms*sizeof(symstk),XSYMCHUNK);
 xsyms[xnsyms-1].heap=xheapsize;
 xsyms[xnsyms-1].root=NIL_NODE;
 return(xnsyms);
}



/* called once boots symbol table */

os_error * xsymstart(void)
{
 os_error * err;
 xnsyms=0;
 err=flex_alloc((flex_ptr)&xsymheap,XHEAPCHUNK);
 if(!err) err=flex_alloc((flex_ptr)&xsyms,XSYMCHUNK);
 xheapsize=0;

 if(!err) err=addsymboltable(fntable,&fnlink);

 return(err);
}



int symfntype(int argc,int sym,int internal,int * mode)
{
 int      args;
 int      c;
 fndefn * fn;

 if(internal)
 {
  fn=(fndefn*)sym;
  if(argc>=fn->argc)
  {
   *mode=0;
   return(PINT);
  }
  else
  {
   c=fn->args[argc];

   if(c=='R') 
   {
    *mode=PREF;
    return(PSTR);
   }
   else
   {
    *mode=0;
    if(c=='S') return(PSTR);
    else       return(PINT);
   }
  }
 }
 else
 {
  args=xptr(sym)->args;
  args=(args>>(argc*2)) & 0x3;

/*  dprintf(0,"read argc=%d type=%d\n",argc,args); */

  *mode=((args & 0x2)>>1)+1;
  return((args & 0x1)+1);
 }
}


int symfnargc(int sym,int internal)
{
 symstr * sx;

 if(internal)    /* internal function */
 {
  return(((fndefn*)sym)->argc);
 }
 else
 {
  sx=xptr(sym);
  return(sx->argc);
 }
}



void setsymfntype(int argc,int sym,int type,int mode)
{
 symstr * sx;
 int      args;

 sx=xptr(sym);
 args=sx->args;

 argc*=2;
 args&=~(3<<argc);
 args|=(((type-1)+((mode-1)<<1))<<argc);

/*  dprintf(0,"set argc=%d type=%d mode=%d\n",argc/2,type,mode); */

 xptr(sym)->args=args;
}










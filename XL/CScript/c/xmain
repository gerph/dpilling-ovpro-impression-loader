/* string mids(string s,int start,int len) */

int mids(int fp)
{
 int    s;
 char * p;
 char * q;
 int    len;
 int    slen;
 int    start;

 start=stack[fp+1];
 len=stack[fp+2];
 slen=stringlen(stack[fp]); /* C style doesn't count last 0 */

 if(start<0) start=0;
 if(start>slen) start=slen;

 if(len<0) len=0;
 if((len+start)>slen) len=slen-start;

 s=mkstring(len);

 p=stringptr(stack[fp])+start;
 q=stringptr(s);

 memcpy(q,p,len);
 *(q+len)=0;

 return(s);
}



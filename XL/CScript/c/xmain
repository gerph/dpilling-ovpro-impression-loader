/* adds another file to program */
/* return 1 OK 0 ERROR          */

os_error * xaddfile(char * filename,int rarg,int exec,int * result,
                                             int inval,int inval2)
{
 os_error * err;
 int        mode;

 mode=((exec & 0xF0)>>4);

 *result=0;

/* dprintf(0,"xadd %s",filename); */


 err=lexstart(filename,mode);
 if(!err)
 {
  if(!setjmp(xraisejmp))
  {

   err=flex_chunk((flex_ptr)&prstack,
                         (prstages+1)*sizeof(programstage),PRSTACKCHUNK);
   if(!err)
   {
    prstack[prstages].code=xcodesize;
    prstack[prstages].stage=xaddstage();
    prstack[prstages].nostrings=nostrings;
    prstages++;

    err=xparse();
   }


   if(!err) err=lexend(mode);
   else         lexend(mode);

   if(exec)
   {
    if(rarg) xrunmain2(result,rarg,inval,inval2);
    else     xrunmain(result); /* NB we are using result to flag */
                               /* compilation not run result     */
   }

   *result=1;
   return(err);
  }
  else
  {
   err=lexend(mode);
   xremfile();
  /* *result=ZRLEXERR; */
   return(err);
  }
 }
 return(err);
}



/* think about name not found, apart from real errors */

os_error * addfiles(char * name,int remove)
{
 os_error * err;
 fxstat     f;
 char       temp[256];
 int        code;
 char     * p;
 int        eof;
 int        save;

 err=fs_stat(name,&f.f);
 if(!err && f.f.object)
 {
  fs_startscan();

  strcpy(temp,name);
  p=temp+strlen(temp);

  while(1)
  {
   if(fs_nextitem(temp,&f,NULL,&eof)) break;
   if(eof) break;
   fs_savescan(&save);

   if(f.f.object==1)
   {
    *p='.';
    strcpy(p+1,f.name);

    xaddfile(temp,0,1,&code,0,0);
    if(remove && code) xremfile();

    *p=0;
   }

   fs_loadscan(save);
  }
 }

 return(err);
}


/* return 1==OK 0==ERROR */


static int lastcode;


int runscript(char * filename,int exec)
{
 int code;

 xaddfile(filename,0,0,&code,0,0);
 lastcode=code;
 if(code && exec)
 {
  xrunmain(&code);
  xremfile();
  lastcode=0;
 }
 return(code);
}



void runscriptpost(void)
{
 int code;

 if(lastcode)
 {
  xrunmain(&code);
  xremfile();
 }
}




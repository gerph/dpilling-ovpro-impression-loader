static jmp_buf xraisejmp;


void xraise(int errno,...)
{
 va_list args;
 char v[128];
 char format[128];

 strcpy(format,errmessages[errno]);
 trans(format,sizeof(format));

 va_start(args, errno);
 vsprintf(v, format, args);

 va_end(args);

 if(!throwbackstart())
 {
  throwbacksend(Throwback_ReasonProcessing,lexfile);
  throwbacksend(Throwback_ReasonErrorDetails,lexfile,lexline,2,v);

  throwbackend();
 }
 else werr(0,"{XERR}",v,lexline,lexfile);

 longjmp(xraisejmp,1);
}



static os_error * xlock(int handle,int by)
{

 tokstart+=by;
 tokend+=by;
 buffend+=by;

 return(NULL);
 USE(handle);
}



os_error * lexstart(char * filename,int mode)
{
 os_error * err;

 err=NULL;

 if(mode==0)
 {
  err=bf_open(filename,'r',BUFFMINSIZE,&lexbf);
  if(err) return(err);
  lexfile=filename;
 }
 else
  lexfile="macro";

 if(!buff) err=flex_alloc((flex_ptr)&buff,LEXBUFFSIZE+1+3);
 if(!err)
 {
  flex_setlock((flex_ptr)&buff,xlock,0);

  if(mode==0)
  {
   buffend=buff;
   tokstart=tokend=buffend;
   lexeof=0;
   err=lexfill();
  }
  else
  if(mode==1 || mode==2)
  {
   if(mode==1) strcpy(buff,"void main(void) { ");
   else  strcpy(buff,"void main(string & macv,int macenv,int macview) { ");
   strcat(buff,filename);
   strcat(buff,";}\n");
   tokstart=tokend=buff;
   buffend=buff+strlen(buff);
   lexeof=1;
  }

  lexline=1;
  savedchar=0;
 }
 return(err);
}


os_error * lexend(int mode)
{
 os_error * err;
 err=flex_free((flex_ptr)&buff);
 if(mode==0) err=bf_close(&lexbf,err);
 return(err);
}


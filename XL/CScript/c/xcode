/* x assembler and exec */


char   * xcodeheap;      /* heap used to store symbol table        */
int      xcodesize;      /* pointer to first free location in heap */
int    * stack;



typedef struct cpustr
{
 int      sp;
 int      r0;
 int      r1;
 int      r2;
 int      fp;
} cpustr;

static cpustr cpu; 


static jmp_buf zraisejmp;

int  zruns;
int  zlevel;


static char * zerrmessages[MAXRUN]=
{
 "{ZDIVZ}",
 "{ZFILE}",
 "{ZUSER}",
 "{ZNULL}",
 "{ZMEM}"
};


void zraise(int errno, ...)
{
 va_list args;
 char    v[128];
 char    format[128];

 strcpy(format,zerrmessages[errno]);
 trans(format,sizeof(format));

 va_start(args,errno);
 vsprintf(v,format,args);

 va_end(args);

 if(errno!=ZEXIT) werr(0,"{ZERR}",v);

 longjmp(zraisejmp,1);
}


void zreport(os_error * err)
{
 if(err)
 {
  report(err);
  longjmp(zraisejmp,1);
 }
}



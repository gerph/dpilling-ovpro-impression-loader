/* length of string */

int stringlen(int s1)
{
/* return(strlen(stringptr(s1))); */
 return(stringmap[s1].curlen);
}



/* nth. char in string */

int stringn(int s1,int n)
{
 char * p;
 int    len;

 p=stringptr(s1);
 len=stringmap[s1].curlen;

 if(n<0) n=0;
 if(n>len) n=len;

 return(*(p+n));
}



/* called once boots string table */

os_error * xstringstart(void)
{
 os_error * err;
 err=flex_alloc((flex_ptr)&stringspace,STRCHUNK);
 if(!err) err=flex_alloc((flex_ptr)&stringmap,STRMAPCHUNK);
 stringsize=0;
 nostrings=0;
 return(err);
}





os_error * incarrot(int wh,int ih)
{
 os_error * err;
 char     * c;
 char     * p;

 err=iconaddr(wh,ih,&p);
 if(!err)
 {
  c=p;
  while(1)
  {
   if((*c<'0' || *c>'9') && *c!='.' && *c!='/') break;
   c++;
  }
  err=caret(wh,ih,0,0,-1,c-p);
 }

 return(err);
}





void getcurdeltas(int * dx,int * dy)
{
 int lndeltax=bbc_vduvar(bbc_XEigFactor);
 int lndeltay=bbc_vduvar(bbc_YEigFactor);
 *dx=(1 << lndeltax);
 *dy=(1 << lndeltay);
}



os_error * fs_read(int fh,void * b,int n)
{
 os_error * err;
 os_regset  rx;

 rx.r[0]=4;
 rx.r[1]=fh;
 rx.r[2]=(int)b;
 rx.r[3]=n;

 err=os_swix(OS_GBPB,&rx);

 if(!err && rx.r[3]) err=geterror(ERD);

 return(err);
}




os_error * fs_getc(int fh,int * c)
{
 os_error * err;
 int        eof;

 err=fs_eof(fh,&eof);
 if(!err)
 {
  if(eof) *c=-1;
  else
  {
   *c=0;
   err=fs_read(fh,c,1);
  }
 }

 return(err);
}




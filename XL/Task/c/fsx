os_error * fs_eof(int fh,int * eof)
{
 os_error * err;
 os_regset  rx;

 rx.r[0]=5;
 rx.r[1]=fh;

 err=os_swix(OS_Args,&rx);

 *eof=rx.r[2];

 return(err);
}



os_error * fs_tell(int fh,int * posn)
{
 os_regset  rx;
 os_error * err;

 rx.r[0]=0;
 rx.r[1]=fh;

 err=os_swix(OS_Args,&rx);

 *posn=rx.r[2];

 return(err);
}



os_error * fs_open(char * name,int mode,int * fh)
{
 os_regset  rx;
 os_error * err;
 fstat      f;

 err=NULL;

 if(mode=='r') rx.r[0]=0x4F;
 else
 if(mode=='w') rx.r[0]=0x8F;
 else
 if(mode=='u')
 {
  err=fs_stat(name,&f);
  if(!err)
  {
   if(f.object) rx.r[0]=0xCF;
   else         rx.r[0]=0x8F;
  }
 }

 if(!err)
 {
  rx.r[1]=(int)name;

  err=os_swix(OS_Find,&rx);

  *fh=rx.r[0];
 }

 return(err);
}



os_error * fs_close(int fh,os_error * ep)
{
 os_regset  rx;
 os_error * err;

 rx.r[0]=0;
 rx.r[1]=fh;

 err=os_swix(OS_Find,&rx);

 if(!ep) return(err);
 else    return(ep);
}





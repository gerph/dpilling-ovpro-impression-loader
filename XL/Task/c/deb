 {
  rx.r[0]=202;
  rx.r[1]=0;
  rx.r[2]=-1;

  os_swix(OS_Byte,&rx);

  if(!(rx.r[1] & 0x10))
  {
#ifdef DAPPEND
   if(!dbfp) dbfp=fopen("xx","ab+");
   if(dbfp)
   {
    fprintf(dbfp,"%s\n",v);
    fclose(dbfp);

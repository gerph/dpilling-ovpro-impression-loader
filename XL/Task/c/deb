  }
  else
  {
   bbc_vdu(4);bbc_vdu(30);
   while(line--) bbc_vdu(10);
   printf("%-40s",v);
   bbc_vdu(5);
   if(isctrl) bbc_get();
  }
 }

 va_end(args);
}


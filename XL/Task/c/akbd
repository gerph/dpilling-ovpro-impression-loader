/* any keys other than shifts pressed? */

int akbd_others(void)
{
  int x = 9;
  int y = 0;
  (void) os_byte(121, &x, &y);
  return(x!=255);
}




int bbc_inkey(int delay)
{
 int x = delay;
 int y = delay>>8;
 (void) os_byte(129, &x, &y);
 if(!y) return(x);
 else   return(-1);
}

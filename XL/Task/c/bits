/* expands <x$y> form path */

os_error * expandpath(char * path,char * buff,int buffsize)
{
 os_error * err;
 os_regset  rx;

 err=NULL;

 rx.r[0]=(int)path;
 rx.r[1]=(int)buff;
 rx.r[2]=buffsize;

 err=os_swix(OS_GSTrans,&rx);
 if(err) buff[0]=0;
 else    buff[rx.r[2]]=0;

 return(err);
}


